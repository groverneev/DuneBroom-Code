import time
import sys
import serial
import cv2
from ultralytics import YOLO

# ========= USER SETTINGS =========
ARDUINO_PORT = "/dev/ttyACM0"        # Consider a stable symlink: /dev/serial/by-id/...
BAUD = 9600
MODEL_PATH = "/home/neev/Downloads/runs/yolov11_custom/weights/best.pt"
CAM_INDEX = 0                        # 0 = default camera
BURST_SECONDS = 1.5                  # How long to sample frames per decision
MIN_CONF = 0.35                      # Min confidence to count a detection
SHOW_WINDOW = False                  # Set True if you want to see annotated video

# Map your trained class names to "nature" or "trash"
# Fill these with the *exact* string names in your model (model.names).
NATURE_CLASSES = {"tree", "plant", "leaf", "sand", "rock", "grass", "seaweed", "shell", "driftwood", "nature"}
TRASH_CLASSES  = {"bottle", "can", "plastic", "cup", "bag", "straw", "wrapper", "mask", "trash"}

DEFAULT_DECISION_IF_NO_DETECTIONS = "nature"   # or "trash"
# =================================

def open_serial():
    try:
        ser = serial.Serial(ARDUINO_PORT, BAUD, timeout=0.1)
        time.sleep(2.0)  # allow Arduino to reset after port open
        return ser
    except Exception as e:
        print(f"[ERR] Could not open serial {ARDUINO_PORT}: {e}")
        sys.exit(1)

def write_line(ser, s: str):
    ser.write((s.strip() + "\n").encode("utf-8"))
    ser.flush()

def read_line(ser):
    try:
        line = ser.readline().decode("utf-8", errors="ignore").strip()
        return line if line else None
    except:
        return None

def decide_group_from_results(result, names):
    """Return ('nature' or 'trash', score_nature, score_trash, total_counts) for a single frame."""
    nature_score = 0.0
    trash_score = 0.0
    count = 0

    boxes = getattr(result, "boxes", None)
    if boxes is None or boxes.cls is None or boxes.conf is None:
        return None, 0.0, 0.0, 0

    for cls_id, conf in zip(boxes.cls.tolist(), boxes.conf.tolist()):
        cls_id = int(cls_id)
        conf = float(conf)
        if conf < MIN_CONF:
            continue

        label = names.get(cls_id, str(cls_id)).lower()
        count += 1
        if label in NATURE_CLASSES:
            nature_score += conf
        elif label in TRASH_CLASSES:
            trash_score += conf
        # else: unseen class → ignore

    if nature_score == 0 and trash_score == 0:
        return None, 0.0, 0.0, count

    if trash_score > nature_score:
        return "trash", nature_score, trash_score, count
    else:
        return "nature", nature_score, trash_score, count

def run_inference_burst(model, cap):
    """Capture frames for BURST_SECONDS, aggregate a vote, return 'nature' or 'trash'."""
    t0 = time.time()
    names = model.names if hasattr(model, "names") else getattr(model.model, "names", {})
    agg_nature = 0.0
    agg_trash = 0.0
    total_detections = 0

    last_annotated = None

    while time.time() - t0 < BURST_SECONDS:
        ok, frame = cap.read()
        if not ok or frame is None:
            continue

        results = model(frame, verbose=False)
        if not results:
            continue
        res = results[0]

        # Show window if desired
        if SHOW_WINDOW:
            if last_annotated is None:
                last_annotated = res.plot()
            else:
                last_annotated = res.plot()
            cv2.imshow("YOLO Detection", last_annotated)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                break

        decision, ns, ts, cnt = decide_group_from_results(res, names)
        total_detections += cnt
        agg_nature += ns
        agg_trash  += ts

    # Final vote
    if agg_nature == 0 and agg_trash == 0:
        return DEFAULT_DECISION_IF_NO_DETECTIONS

    return "trash" if agg_trash > agg_nature else "nature"

def main():
    print("[INFO] Loading YOLO model...")
    model = YOLO(MODEL_PATH)

    print("[INFO] Opening camera...")
    cap = cv2.VideoCapture(CAM_INDEX)
    if not cap.isOpened():
        print("[ERR] Could not open camera index", CAM_INDEX)
        sys.exit(1)

    ser = open_serial()
    print("[OK] Ready. Waiting for Arduino trigger...")

    try:
        while True:
            line = read_line(ser)
            if line is None:
                continue

            # Expect '0' from Arduino when an object is close
            if line == "0":
                print("[TRIGGER] Object close. Running inference burst...")
                decision = run_inference_burst(model, cap)
                print(f"[DECISION] {decision}")

                if decision == "trash":
                    write_line(ser, "1")  # tell Arduino to go backward 4s
                else:
                    write_line(ser, "0")  # tell Arduino to go forward 4s

            # Optional: allow keyboard exit
            if SHOW_WINDOW:
                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break

    except KeyboardInterrupt:
        print("\n[EXIT] KeyboardInterrupt")
    finally:
        cap.release()
        if SHOW_WINDOW:
            cv2.destroyAllWindows()
        ser.close()

if __name__ == "__main__":
    main()











































#include <Wire.h>

// ===== I2C Motor Driver Address
#define I2C_ADDR        0x34

// ===== Registers
#define MOTOR_TYPE_ADDR               0x14
#define MOTOR_ENCODER_POLARITY_ADDR   0x15
#define MOTOR_FIXED_SPEED_ADDR        0x33
#define MOTOR_ENCODER_TOTAL_ADDR      0x3C

// ===== Motor type constant
#define MOTOR_TYPE_JGB37_3865_520_12V_150RPM 3

// ===== Ultrasonic pins
const int trigPin = 9;
const int echoPin = 10;

// ===== Behavior tuning
const float TRIGGER_DIST_CM = 20.0;  // "20 units" assumed to be centimeters
const uint32_t DECISION_MOVE_MS = 4000; // 4 seconds per your spec
const uint32_t PI_REPLY_TIMEOUT_MS = 7000; // wait up to 7s for Pi
const uint32_t RETRIGGER_DEBOUNCE_MS = 600; // avoid immediate retriggers

// ===== Motor speeds (signed)
int8_t stopCmd[4]     = {  0,   0, 0, 0};
int8_t forwardCmd[4]  = { 50,  50, 0, 0};   // tweak as needed
int8_t backwardCmd[4] = {-50, -50, 0, 0};

// ===== Misc
uint8_t MotorType = MOTOR_TYPE_JGB37_3865_520_12V_150RPM;
uint8_t MotorEncoderPolarity = 0;

float measureDistanceCm();
float median5(float a, float b, float c, float d, float e);
bool WireWriteDataArray_u8(uint8_t reg, const uint8_t *val, unsigned int len);
bool WireWriteDataArray_i8(uint8_t reg, const int8_t *val, unsigned int len);

void driveStop()    { WireWriteDataArray_i8(MOTOR_FIXED_SPEED_ADDR, stopCmd,     4); }
void driveForward() { WireWriteDataArray_i8(MOTOR_FIXED_SPEED_ADDR, forwardCmd,  4); }
void driveBackward(){ WireWriteDataArray_i8(MOTOR_FIXED_SPEED_ADDR, backwardCmd, 4); }

void setup() {
  Wire.begin();
  Serial.begin(9600);
  delay(200);

  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  // Configure motor type and encoder polarity
  WireWriteDataArray_u8(MOTOR_TYPE_ADDR, &MotorType, 1);
  delay(5);
  WireWriteDataArray_u8(MOTOR_ENCODER_POLARITY_ADDR, &MotorEncoderPolarity, 1);

  // Start forward
  driveForward();
}

void loop() {
  // Smooth distance: median of 5 quick reads
  float d = median5(
    measureDistanceCm(),
    measureDistanceCm(),
    measureDistanceCm(),
    measureDistanceCm(),
    measureDistanceCm()
  );

  if (d < TRIGGER_DIST_CM) {
    // Stop and notify Pi ONCE
    driveStop();
    Serial.println("0"); // tell Pi: object close
    uint32_t t0 = millis();

    // Wait for reply from Pi: "0" (nature) or "1" (trash)
    bool gotDecision = false;
    while (millis() - t0 < PI_REPLY_TIMEOUT_MS) {
      if (Serial.available() > 0) {
        String msg = Serial.readStringUntil('\n');
        msg.trim();

        if (msg == "0") {
          // Nature → go forward 4s
          driveForward();
          delay(DECISION_MOVE_MS);
          driveStop();
          gotDecision = true;
          break;
        } else if (msg == "1") {
          // Trash → go backward 4s
          driveBackward();
          delay(DECISION_MOVE_MS);
          driveStop();
          gotDecision = true;
          break;
        }
      }
      delay(5);
    }

    // Failsafe if Pi didn't answer: brief back-off, then stop
    if (!gotDecision) {
      driveBackward();
      delay(1200);
      driveStop();
    }

    // Small pause + resume forward loop
    delay(150);
    driveForward();

    // Debounce to avoid immediate retrigger at same obstacle
    delay(RETRIGGER_DEBOUNCE_MS);
  }

  delay(50); // loop pacing
}

// ---- Distance (cm) with timeout
float measureDistanceCm() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  // 30ms timeout (~5m); returns 0 on timeout
  unsigned long duration = pulseIn(echoPin, HIGH, 30000);
  if (duration == 0) return 500.0;  // treat as "far away"
  return duration * 0.0343 / 2.0;   // speed of sound ~343m/s
}

// ---- Median of 5 (robust filter)
float median5(float a, float b, float c, float d, float e) {
  float arr[5] = {a, b, c, d, e};
  // simple insertion sort
  for (int i = 1; i < 5; i++) {
    float key = arr[i];
    int j = i - 1;
    while (j >= 0 && arr[j] > key) {
      arr[j+1] = arr[j];
      j--;
    }
    arr[j+1] = key;
  }
  return arr[2]; // middle
}

// ---- I2C helpers
bool WireWriteDataArray_u8(uint8_t reg, const uint8_t *val, unsigned int len) {
  Wire.beginTransmission(I2C_ADDR);
  Wire.write(reg);
  for (unsigned int i = 0; i < len; i++) {
    Wire.write(val[i]);
  }
  return Wire.endTransmission() == 0;
}

bool WireWriteDataArray_i8(uint8_t reg, const int8_t *val, unsigned int len) {
  Wire.beginTransmission(I2C_ADDR);
  Wire.write(reg);
  for (unsigned int i = 0; i < len; i++) {
    Wire.write((uint8_t)val[i]); // send raw byte (two's complement for negatives)
  }
  return Wire.endTransmission() == 0;
}



